{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "site",
  "buildCommand": "python3 tools/build_site.py && python3 tools/build_artifact.py",
  "installCommand": "echo \"no dependencies: the pipeline is standard library Python\"",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/py/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=600" }]
    },
    {
      "source": "/data/bundle.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=600" }]
    }
  ]
}
